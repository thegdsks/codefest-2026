# Backend env vars. Copy to .env and adjust as needed.
# .env is gitignored and never committed.

# App-level auth used by handler.js.
CLIENT_ID=demoClient
CLIENT_SECRET=demoSecret
MFA_OTP=123456

# DynamoDB table names. Defaults match the CDK output.
TABLE_USER_PROFILE=UserProfile
TABLE_USER_SESSION=UserSession
TABLE_USER_ACTIVITY=UserActivity
TABLE_DECISION_STORE=DecisionStore
TABLE_USER_STATE=UserState

# Only needed for `serverless deploy`. Not required for `serverless offline`.
# When unset, serverless.yml falls back to 000000000000 so config still resolves.
# AWS_ACCOUNT_ID=123456789012

# AWS region for deploys. Defaults to us-east-1.
# AWS_REGION=us-east-1
