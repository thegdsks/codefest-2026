# Frontend env vars. Copy to .env.local for `npm run dev`.
# .env.local is gitignored and never committed.

# Base URL of the backend API. For local dev with `serverless offline`:
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Basic Auth at the gateway. Must match backend CLIENT_ID/CLIENT_SECRET.
NEXT_PUBLIC_CLIENT_ID=demoClient
NEXT_PUBLIC_CLIENT_SECRET=demoSecret

# Public site URL used for OG metadata and canonical links.
# https://signal-force-codefest.vercel.app or your deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3001
