# Frontend env vars. Copy to .env.local for `npm run dev`.
# .env.local is gitignored and never committed.

# Base URL of the backend API. For local dev with `serverless offline`:
VITE_API_BASE_URL=http://localhost:3000

# Basic Auth at the gateway. Must match backend CLIENT_ID/CLIENT_SECRET.
VITE_CLIENT_ID=demoClient
VITE_CLIENT_SECRET=demoSecret
