# Copy this file to .env and fill in real values. NEVER commit .env.

# Basic Auth client credentials (used by all API consumers)
CLIENT_ID=demoClient
CLIENT_SECRET=demoSecret

# Demo MFA OTP (hackathon shortcut - single static OTP across all sessions)
MFA_OTP=123456

# DynamoDB table names (must match the names in infra/cloudformation/01-dynamodb-tables.yml)
TABLE_USER_PROFILE=UserProfile
TABLE_USER_SESSION=UserSession
TABLE_USER_ACTIVITY=UserActivity
TABLE_DECISION_STORE=DecisionStore
TABLE_USER_STATE=UserState

# AWS deploy target
AWS_REGION=us-east-1
SLS_STAGE=dev

# Frontend → backend (set after `serverless deploy` outputs the API endpoint)
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
VITE_CLIENT_ID=demoClient
VITE_CLIENT_SECRET=demoSecret

# Budget alarm notification (used by infra/cloudformation/02-budgets.yml)
BUDGET_ALERT_EMAIL=your-email@example.com
