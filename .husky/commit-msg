MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Block em dashes (AI tell, project rule)
if printf '%s' "$MSG" | grep -q '—'; then
  echo "commit-msg: em dash detected. Use commas, parens, or hyphens instead." >&2
  exit 1
fi

# Block AI mentions
if printf '%s' "$MSG" | grep -qiE 'claude|copilot|cursor[- ]ai|co.?authored|generated by|with assistance from|written by AI|AI[- ](gener|assist)'; then
  echo "commit-msg: AI mention detected. Keep commits attributable to a single human author." >&2
  exit 1
fi

# Block Co-Authored-By footers regardless of who
if printf '%s' "$MSG" | grep -qiE '^co-authored-by:'; then
  echo "commit-msg: Co-Authored-By footer not allowed in this repo." >&2
  exit 1
fi

# Subject line under 72 chars
SUBJECT=$(head -1 "$MSG_FILE")
LEN=${#SUBJECT}
if [ "$LEN" -gt 72 ]; then
  echo "commit-msg: subject is $LEN chars, max is 72. Shorten." >&2
  exit 1
fi
