MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")
ISSUES=0

# Collect all issues, print at the end with examples, do not block unless HUSKY_STRICT=1.
report() {
  if [ "$ISSUES" -eq 0 ]; then
    printf '\n'
    printf 'commit-msg: heads up. Not blocking. Set HUSKY_STRICT=1 to enforce.\n'
    printf '\n'
  fi
  ISSUES=$((ISSUES + 1))
  printf '  %s\n\n' "$1"
}

# 1. Em dashes (AI tell)
if printf '%s' "$MSG" | grep -q '—'; then
  report "Em dash (—) found in message.
    Em dashes are a strong AI tell. Use commas, parens, or hyphens.
    bad:  Add login flow — handles MFA
    good: Add login flow with MFA handling"
fi

# 2. AI mentions
if printf '%s' "$MSG" | grep -qiE 'claude|copilot|cursor[- ]ai|generated by|with assistance from|written by AI|AI[- ](gener|assist)'; then
  report "AI mention found in message.
    Commits stay attributable to a single human author for this project.
    Remove references to Claude, Copilot, Cursor, 'generated by', etc."
fi

# 3. Co-Authored-By footer
if printf '%s' "$MSG" | grep -qiE '^co-authored-by:'; then
  report "Co-Authored-By footer found.
    Drop the footer. Keep commits attributable to one human author."
fi

# 4. Subject length
SUBJECT=$(head -1 "$MSG_FILE")
LEN=${#SUBJECT}
if [ "$LEN" -gt 72 ]; then
  report "Subject line is $LEN chars, target is 72 or less.
    Shorten or move detail to the body, leaving one blank line after subject."
fi

# 5. Emojis in subject (basic detection of common ranges)
if printf '%s' "$SUBJECT" | LC_ALL=C grep -qP '[\x{1F300}-\x{1FAFF}\x{2600}-\x{27BF}]' 2>/dev/null; then
  report "Emoji found in subject line.
    No emojis in commit messages, please. Stick to plain text."
fi

if [ "$ISSUES" -gt 0 ]; then
  printf 'commit-msg: %d issue(s) found.\n' "$ISSUES"
  if [ "$HUSKY_STRICT" = "1" ]; then
    printf 'HUSKY_STRICT=1 is set, blocking this commit. Unset to merge with warnings.\n' >&2
    exit 1
  fi
  printf 'Tip: amend with git commit --amend if you want to fix this one now.\n'
fi

exit 0
