{
  "name": "signal-force-cdk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth --quiet",
    "synth:fast": "CDK_NAG=off cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "test": "jest --colors",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.0",
    "@types/source-map-support": "^0.5.10",
    "aws-cdk": "^2.180.0",
    "cdk-nag": "^2.38.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  }
}
