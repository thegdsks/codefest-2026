{
  "info": {
    "_postman_id": "sf-v1-collection-2026",
    "name": "Signal Force API",
    "description": "Signal Force fraud-aware loyalty platform. One folder per API surface. Bearer token is acquired via Auth/Login + Auth/MFA Verify then stored in the {{bearerToken}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    },
    {
      "key": "mfaSessionId",
      "value": ""
    },
    {
      "key": "decisionId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Compute basicAuth from clientId + clientSecret at collection level",
          "const clientId = pm.environment.get('clientId') || pm.collectionVariables.get('clientId') || 'demoClient';",
          "const clientSecret = pm.environment.get('clientSecret') || pm.collectionVariables.get('clientSecret') || 'demoSecret';",
          "const encoded = btoa(clientId + ':' + clientSecret);",
          "pm.environment.set('basicAuth', 'Basic ' + encoded);",
          "// Default userId if not set",
          "if (!pm.environment.get('userId') && !pm.collectionVariables.get('userId')) {",
          "  pm.environment.set('userId', 'USER#031');",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints. Run Login first, then MFA Verify to obtain a bearer token.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{basicAuth}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maya031\",\n  \"password\": \"Password1\",\n  \"location\": \"Austin\",\n  \"deviceId\": \"postman-device-001\",\n  \"deviceType\": \"desktop\",\n  \"browser\": \"Chrome\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate a loyalty member. Returns a sessionId for MFA verify when the fraud engine requires a challenge, or a direct access token for low-risk logins."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const d = b.data || b;",
                  "pm.test('has status field', () => pm.expect(d).to.have.property('status'));",
                  "if (d.token) pm.collectionVariables.set('bearerToken', d.token);",
                  "if (d.sessionId) pm.collectionVariables.set('mfaSessionId', d.sessionId);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "MFA Verify",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{basicAuth}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{mfaSessionId}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "mfa", "verify"]
            },
            "description": "Complete MFA challenge from Login. Accepts a TOTP code or the static demo OTP (123456 in demo mode). Stores the bearer token in {{bearerToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const d = b.data || b;",
                  "pm.test('has token', () => pm.expect(d).to.have.property('token'));",
                  "if (d.token) pm.collectionVariables.set('bearerToken', d.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "MFA Enroll (start)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "mfa", "enroll"]
            },
            "description": "Begin TOTP enrollment for a user. Returns a provisioning URI and QR code seed to display in an authenticator app."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "MFA Confirm Enroll",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"otp\": \"<6-digit TOTP code>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/confirm-enroll",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "mfa", "confirm-enroll"]
            },
            "description": "Confirm TOTP enrollment by submitting a valid code from the authenticator app. Locks the secret into the user profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revoke the current bearer token. The ACCESS session row is deleted from DynamoDB."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Session Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "session"]
            },
            "description": "Return metadata for the current session (token expiry, userId, sessionId, MFA path used)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
